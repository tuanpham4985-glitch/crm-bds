{
  "name": "crm-bds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:crm": "tsx --test tests/crm/*.test.ts",
    "postinstall": "prisma generate",
    "migrate": "node scripts/migrate-to-gsheets.mjs",
    "repair": "node scripts/repair-gsheets.mjs",
    "db:migrate": "prisma migrate dev",
    "db:sync": "tsx --env-file=.env.local scripts/sync-sheets-to-pg.ts",
    "db:verify": "tsx --env-file=.env.local scripts/verify-data-integrity.ts",
    "db:sync:tm": "tsx --env-file=.env.local scripts/sync-sheets-to-pg.ts --module=tm",
    "db:sync:attendance-to-sheets": "tsx --env-file=.env.local scripts/sync-attendance-pg-to-sheets.ts",
    "export:ccn-photos": "tsx --env-file=.env.local scripts/export-attendance-photos.ts",
    "purge:ccn": "tsx --env-file=.env.local scripts/purge-attendance-test.ts",
    "sync_employee": "tsx --env-file=.env.local scripts/task-management/sync-employees.ts",
    "sync:employees": "tsx --env-file=.env.local scripts/task-management/sync-employees.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/nodemailer": "^8.0.0",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.5",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "nodemailer": "^8.0.10",
    "pg": "^8.22.0",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "swr": "^2.4.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@prisma/client": "^7.8.0",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.61.1"
  }
}
