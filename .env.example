# ============================================================
# CRM BĐS — VICTORY HOLDINGS
# Environment Variables Example
# Copy to .env.local and fill in your values
# ============================================================

# ─── Google Sheets (Main CRM database) ──────────────────────
GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_main_spreadsheet_id_here

# ─── PostgreSQL (required for transactional CRM funnel) ─────
DATABASE_URL=postgresql://user:password@host:5432/crm
# Qualified Lead Funnel fails closed unless `crm` is enabled after migration.
PG_ENABLED_MODULES=crm

# ─── Google Sheets (Task Management module) ─────────────────
# Can be same sheet as above or a separate one
TM_GOOGLE_SHEET_ID=your_task_management_spreadsheet_id_here

# ─── App ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_secret_min_32_chars_here

# ─── Email (optional — for notifications) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@victoryholdings.vn

# ─── Upload (optional) ──────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
